   "source": [
    "import numpy as np\n",
    "\n",
    "X = np.array([[50, 2, 3],\n",
    "              [70, 3, 5],\n",
    "              [60, 2, 2],\n",
    "              [80, 4, 6]])\n",
    "y = np.array([[5.0],\n",
    "              [7.0],\n",
    "              [5.5],\n",
    "              [8.5]])\n",
    "\n",
    "# Находим веса\n",
    "w = np.linalg.pinv(X) @ y\n",
    "print(w)"
   ]
  }
 ],
